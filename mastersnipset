<div id="ig-checkout-modal" class="fixed inset-0 z-[9999] hidden flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 font-sans opacity-0 transition-opacity duration-300">
    <div class="bg-[#1A1A1A] w-full max-w-md rounded-2xl shadow-2xl border border-[#2A2A2A] overflow-hidden transform scale-95 transition-transform duration-300" id="ig-modal-content">
        <div class="bg-[#222] px-6 py-4 border-b border-[#2A2A2A] flex justify-between items-center relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#FF6A00]/10 rounded-bl-full -mr-4 -mt-4 z-0"></div>
            <div class="flex items-center relative z-10 w-full justify-between pr-4">
                <h3 class="text-lg font-bold text-white flex items-center">Checkout</h3>
                <div id="ig-agency-badge" class="hidden text-right">
                    <p class="text-[10px] text-gray-500 uppercase tracking-wider mb-0.5">Penjual Resmi</p>
                    <p id="ig-agency-name" class="text-sm font-semibold text-[#FF6A00] truncate max-w-[120px]">Memuat...</p>
                </div>
            </div>
            <button id="ig-close-btn" class="text-gray-400 hover:text-white relative z-10 ml-2">✕</button>
        </div>
        <div class="p-6">
            <div id="ig-loader" class="flex flex-col items-center justify-center py-10">
                <div class="w-8 h-8 border-4 border-[#2A2A2A] border-t-[#FF6A00] rounded-full animate-spin mb-4"></div>
                <p class="text-gray-400 text-sm">Menghubungkan server...</p>
            </div>
            <div id="ig-main-content" class="hidden">
                <div class="mb-6 p-4 bg-black rounded-xl border border-[#2A2A2A]">
                    <p class="text-xs text-gray-500 font-mono mb-1">PRODUK</p>
                    <h4 id="ig-prod-name" class="text-lg font-bold text-white leading-tight">Nama Produk</h4>
                    <div class="mt-3 flex justify-between items-center border-t border-[#333] pt-3">
                        <span class="text-sm text-gray-400">Total Tagihan</span>
                        <span id="ig-prod-price" class="text-xl font-bold text-[#FF6A00]">Rp 0</span>
                    </div>
                </div>
                <form id="ig-form-order" class="space-y-4">
                    <div><label class="block text-sm text-gray-300 mb-1">Nama Lengkap</label><input type="text" id="ig-input-name" required class="w-full px-4 py-2 bg-black border border-[#2A2A2A] text-white rounded-lg outline-none"></div>
                    <div class="grid grid-cols-2 gap-4">
                        <div><label class="block text-sm text-gray-300 mb-1">WhatsApp</label><input type="number" id="ig-input-wa" required class="w-full px-4 py-2 bg-black border border-[#2A2A2A] text-white rounded-lg outline-none"></div>
                        <div><label class="block text-sm text-gray-300 mb-1">Email</label><input type="email" id="ig-input-email" required class="w-full px-4 py-2 bg-black border border-[#2A2A2A] text-white rounded-lg outline-none"></div>
                    </div>
                    <div class="mt-6 pt-6 border-t border-[#2A2A2A]">
                        <h4 class="text-sm font-bold text-white mb-3 text-center">Metode Pembayaran</h4>
                        <div id="ig-qris-container" class="hidden mb-4 p-2 bg-white rounded-xl mx-auto w-40 h-40 border-4 border-[#FF6A00]"><img id="ig-qris-img" src="" class="w-full h-full object-cover rounded-lg"></div>
                        <div class="bg-[#222] p-4 rounded-xl border border-[#2A2A2A] text-center">
                            <p id="ig-bank-details" class="text-lg font-bold text-[#FF6A00] tracking-wide">BCA 1234567</p>
                            <p id="ig-bank-owner" class="text-xs text-gray-400 mt-1 uppercase">A.N BUNDA</p>
                        </div>
                    </div>
                    <button type="submit" id="ig-submit-btn" class="w-full bg-[#FF6A00] text-white py-3.5 rounded-xl font-bold mt-6 shadow-lg shadow-[#FF6A00]/30">Kirim Pesanan ke WA ➔</button>
                </form>
            </div>
            <div id="ig-error-state" class="hidden flex flex-col items-center justify-center py-8 text-center">
                <p class="text-red-500 mb-2">❌</p><h4 class="text-white font-bold mb-1">Akses Ditolak</h4>
                <p class="text-gray-400 text-sm">Pastikan Anda menggunakan link promosi resmi dari Affiliate kami.</p>
            </div>
        </div>
    </div>
</div>

<script>
    // ⚠️ GANTI DENGAN URL DEPLOYMENT APPS SCRIPT LU YG TERBARU
    const API_URL = 'https://script.google.com/macros/s/AKfycbxvNE-egrq1utNnYynPgI5pjK-h3sYTSIaU3VySIRyk8g9i_jOjn8GHDC1s80uZeFWVaQ/exec';
    
    let currentAgencyData = null; let selectedProduct = ""; let selectedPrice = "";

    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById('ig-checkout-modal');
        const modalContent = document.getElementById('ig-modal-content');
        const urlParams = new URLSearchParams(window.location.search);
        const refId = urlParams.get('ref') || 'admin';

        document.querySelectorAll('.btn-checkout').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                selectedProduct = btn.getAttribute('data-product') || 'Produk';
                selectedPrice = btn.getAttribute('data-price') || '0';
                document.getElementById('ig-prod-name').innerText = selectedProduct;
                document.getElementById('ig-prod-price').innerText = 'Rp ' + Number(selectedPrice).toLocaleString('id-ID');
                modal.classList.remove('hidden');
                setTimeout(() => { modal.classList.remove('opacity-0'); modalContent.classList.remove('scale-95'); }, 10);
                fetchAgencyInfo(refId);
            });
        });

        document.getElementById('ig-close-btn').addEventListener('click', () => {
            modal.classList.add('opacity-0'); modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        });
        
        document.getElementById('ig-form-order').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!currentAgencyData) return alert('Data belum siap!');
            
            const btn = document.getElementById('ig-submit-btn');
            btn.innerText = "Memproses..."; btn.disabled = true;

            const name = document.getElementById('ig-input-name').value;
            const wa = document.getElementById('ig-input-wa').value;
            const email = document.getElementById('ig-input-email').value;

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    body: JSON.stringify({ 
                        action: 'createOrder', 
                        payload: { productName: selectedProduct, price: selectedPrice, customerName: name, customerWa: wa, customerEmail: email, agencyId: currentAgencyData.id || refId } 
                    })
                });
                const res = await response.json();
                
                let phoneTarget = String(currentAgencyData.phone).replace(/\D/g, '');
                if (phoneTarget.startsWith('0')) phoneTarget = '62' + phoneTarget.substring(1);
                if (phoneTarget.startsWith('8')) phoneTarget = '62' + phoneTarget;

                let bankInfo = currentAgencyData.bankName ? `${currentAgencyData.bankName} ${currentAgencyData.bankAccount}` : 'Sesuai Arahan';
                let msg = `Halo kak ${currentAgencyData.agencyName}, saya mau order:\n\n📦 *${selectedProduct}*\n💰 *Rp ${Number(selectedPrice).toLocaleString('id-ID')}*\n\n👤 *Data Saya:*\nNama: ${name}\nWA: ${wa}\nEmail: ${email}\n\nSaya akan transfer ke rekening *${bankInfo}*. Mohon di-Approve pesanan saya ya kak! (Order ID: ${res.success ? res.data.orderId : 'Manual'})`;
                
                window.location.href = `https://wa.me/${phoneTarget}?text=${encodeURIComponent(msg)}`;
            } catch(e) { alert("Terjadi kesalahan sistem."); btn.innerText = "Coba Lagi"; btn.disabled = false;}
        });

        async function fetchAgencyInfo(agencyId) {
            document.getElementById('ig-loader').classList.remove('hidden');
            document.getElementById('ig-main-content').classList.add('hidden');
            document.getElementById('ig-error-state').classList.add('hidden');
            try {
                const response = await fetch(API_URL, { method: 'POST', body: JSON.stringify({ action: 'getCheckoutInfo', payload: { agencyId: agencyId } }) });
                const result = await response.json();
                if (!result.success) throw new Error(result.error);
                
                currentAgencyData = result.data;
                document.getElementById('ig-agency-name').innerText = currentAgencyData.agencyName;
                document.getElementById('ig-agency-badge').classList.remove('hidden');

                document.getElementById('ig-bank-details').innerText = currentAgencyData.bankName ? `${currentAgencyData.bankName} ${currentAgencyData.bankAccount}` : 'Hubungi Penjual';
                document.getElementById('ig-bank-owner').innerText = currentAgencyData.bankOwner ? `A.N ${currentAgencyData.bankOwner}` : `A.N ${currentAgencyData.agencyName}`;
                if (currentAgencyData.qrisUrl && currentAgencyData.qrisUrl.length > 5) {
                    document.getElementById('ig-qris-img').src = currentAgencyData.qrisUrl;
                    document.getElementById('ig-qris-container').classList.remove('hidden');
                }
                document.getElementById('ig-loader').classList.add('hidden');
                document.getElementById('ig-main-content').classList.remove('hidden');
            } catch (error) { document.getElementById('ig-loader').classList.add('hidden'); document.getElementById('ig-error-state').classList.remove('hidden'); }
        }
    });
</script>
